  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa kaki menara kapel
  radius: 5.5
  speakerName: 
  speakerRole: 
  title: Menara Kapel Merana
  message: 'Menara lonceng itu sudah lama tak berlonceng. Semua kursi di desa ini
    menghadap ke sini. Di kakinya, lilin-lilin putih berbaris dari alun-alun sampai
    ke tangga, rapat seperti butir gandum, dan tak satu pun padam.


    Seseorang
    pernah mencoba menghitungnya dan menyebut angka seribu empat ratus. Orang lain
    menghitung lagi dan mendapat angka yang sama.'
