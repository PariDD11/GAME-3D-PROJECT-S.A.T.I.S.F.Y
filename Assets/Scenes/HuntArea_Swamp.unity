  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa buku mantra
  radius: 4.5
  speakerName: 
  speakerRole: 
  title: Buku Mantra Sekte Kabut
  message: 'Buku tebal dengan sampul kulit lembap terbuka di atas tong. Halaman terakhir:


    "Air
    desa nelayan sudah dikutuk. Tiga malam lagi mereka akan bangun. Maelis di menara
    memberi kita kekuatan, dan sebagai gantinya kita memberinya yang mati."


    Tulisan
    itu diikuti gambar menara dengan bola hijau di puncaknya.'
