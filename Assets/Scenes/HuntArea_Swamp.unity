  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa lilin di dermaga
  radius: 6.5
  speakerName: 
  speakerRole: 
  title: Dermaga Lilin
  message: 'Lilin putih berderet di sepanjang dermaga, dua baris di tiap sisi, terlalu
    rapat untuk dihitung dalam semalam. Semuanya menyala. Hujan semalam tak memadamkan
    satu pun, dan lilin di ujung dermaga lebih tinggi dari yang lain, seperti baru
    diganti.


    Para nelayan tak mau ditanya siapa yang menyalakannya. "Sudah
    dari dulu," kata mereka, dan lekas membereskan jala.'
