  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa gerbang menara
  radius: 6
  speakerName: 
  speakerRole: 
  title: Menara Maelis
  message: 'Menara tulang dan batu hitam menjulang, dikelilingi kristal hijau yang
    berdenyut seperti jantung. Tulang belulang ditumpuk di sepanjang tangga.


    Di
    balik gerbang, sosok berjubah berdiri membelakangi cahaya. Maelis tidak terburu-buru;
    dia hanya menunggu seseorang cukup bodoh untuk mendekat.'
