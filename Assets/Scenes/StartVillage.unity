  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: 'Bicara: Bapa Elric'
  radius: 3.6
  speakerName: 
  speakerRole: 
  title: Bapa Elric
  message: 'Selamat datang di rumah doa Desa Pemula, Nak.


    Lonceng berbunyi
    tiga kali kalau ada Hunter yang gugur dan pulang dengan selamat. Bunyinya jarang,
    syukurlah.


    Makam desa ada tepat di belakang gereja ini. Di sana beristirahat
    warga yang telah lebih dulu, dan satu-dua Hunter yang tak kembali dari hutan.


    Hati-hati
    di Hutan Pemula, dan jangan terlalu bangga pada pedangmu.'
