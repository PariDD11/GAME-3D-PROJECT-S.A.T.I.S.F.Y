  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1904130964}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: 'Bicara: Lyra'
  radius: 3.4
  speakerName: 
  speakerRole: 
  title: Lyra, Penyihir
  message: 'Berdirilah di dalam lingkaran rune dan arahkan sihirmu ke boneka-boneka
    di seberang.


    - Sihir api membakar dan meluas; sihir tanah menahan dan menghancurkan
    dari jauh.

    - Mana pulih sendiri bila kau berhenti merapal beberapa saat.

    -
    Job Penyihir Api dan Penyihir Tanah terbuka di Level 5.


    Kristal di tengah
    lingkaran bergetar bila ada yang bisa memakai sihir. Kau mungkin salah satunya.'
