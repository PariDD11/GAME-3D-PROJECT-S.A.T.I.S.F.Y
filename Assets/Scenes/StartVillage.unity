  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Lihat tali merah
  radius: 3.8
  speakerName: 
  speakerRole: 
  title: Tali Merah di Batas Hutan
  message: 'Seutas tali merah melintang di antara dua pohon, setinggi pinggang. Kainnya
    pudar oleh hujan, tetapi simpul di kedua batang selalu tampak baru.


    Di
    jalan sebelum tali ada jejak sepatu kecil, berjajar lurus dari arah desa. Jejak
    itu berhenti tepat di bawah tali. Di seberangnya, tanah yang sama lembapnya tidak
    menyimpan satu pun jejak.'
