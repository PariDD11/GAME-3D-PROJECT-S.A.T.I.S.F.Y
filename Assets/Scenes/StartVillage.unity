  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: 'Bicara: Juru Kunci'
  radius: 3.4
  speakerName: 
  speakerRole: 
  title: Juru Kunci Makam
  message: 'Jangan khawatir, Nak. Mereka yang tidur di sini tidak mengganggu yang
    hidup.


    Kadang kabut turun dari bukit di malam hari dan lentera kristal
    berpendar sendiri. Itu hanya doa lama yang belum selesai.


    Ada satu nisan
    di sudut barat yang tak bernama. Aku merawatnya juga. Seseorang harus.'
