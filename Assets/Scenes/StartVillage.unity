  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: 'Bicara: Elowen'
  radius: 3.4
  speakerName: 
  speakerRole: 
  title: Elowen, Pemanah
  message: 'Berdiri di belakang garis putih. Tarik napas, bidik, lepaskan.


    -
    Panah terbang lurus; bidik sedikit di atas sasaran yang jauh.

    - Tiga sasaran
    ada di jarak 6, 12, dan 18 langkah.

    - Pemanah (job Archer, Level 5) menembak
    dari jauh sambil bergerak: menghindar dulu, lalu menembak.


    Boneka di depan
    tiap sasaran tidak membalas. Pakailah sepuasnya.'
