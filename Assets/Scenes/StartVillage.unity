  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Lihat Lumbung & Kandang
  radius: 3.6
  speakerName: 
  speakerRole: 
  title: Lumbung & Kandang Desa
  message: 'Lumbung besar milik bersama warga kampung. Hasil panen disimpan di loteng,
    sapi dan domba merumput di padang sebelah.


    Peternak sering menitipkan pesan
    di papan dekat pintu: kadang ada yang butuh bantuan mengusir slime dari kebun.'
