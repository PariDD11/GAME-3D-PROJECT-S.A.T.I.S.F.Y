MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1713375169}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa sapu dan jejak kaki
  radius: 4.2
  speakerName: 
  speakerRole: 
  title: Dua Belas Sapu
  message: 'Dua belas sapu panjang bersandar pada tonggak batu, melingkari kuil.
    Gagangnya licin oleh telapak tangan yang sama selama berabad-abad. Semuanya condong
    ke dalam, ke arah kuil; tak satu pun bersandar ke dinding.


    Di pasir antara
    sapu dan dinding, jejak kaki dua belas orang berputar mengitari kuil, berulang-ulang,
    tiap pasang dengan langkah dan ukuran sendiri. Tak ada satu jejak pun yang naik
    ke tangga dan masuk. Namun lantai di dalam bersih sempurna.'
