  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa relung yang kosong
  radius: 3.8
  speakerName: 
  speakerRole: 
  title: Relung yang Dikerat
  message: 'Relung ini setinggi dan selebar yang lain, tetapi dindingnya halus seperti
    telapak tangan: tanpa ukiran, tanpa debu, tanpa cahaya. Di dasar relung-relung
    lain masih terbaca tulisan kuno; di sini seseorang pernah mengerat semuanya sampai
    batunya rata.


    Di lantai hanya tersisa lingkaran pucat, bekas sesuatu yang
    pernah berdiri di situ. Orang-orang oasis tak mau menyebut apa yang dulu ada
    di sini, dan tak ada yang berani menuliskannya.'
