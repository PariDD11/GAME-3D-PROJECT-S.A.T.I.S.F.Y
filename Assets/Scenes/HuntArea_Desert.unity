  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa batu jalan
  radius: 4.5
  speakerName: 
  speakerRole: 
  title: Batu Jalan Gerbang Pagi
  message: 'Batu jalan ini menandai tempat kafilah meninggalkan kota. Di mukanya
    terpahat lingkaran dengan garis-garis pendek di tepinya: matahari yang baru terbit.
    Orang kota menamai gerbang timur mereka Gerbang Pagi, sebab dari ambangnya matahari
    pertama terlihat memanjat tembok.


    Di kaki batu ada garis garam setebal
    dua jari, tak putus. Kafilah selalu menambahnya sebelum berangkat ke Gurun Zahar.'
