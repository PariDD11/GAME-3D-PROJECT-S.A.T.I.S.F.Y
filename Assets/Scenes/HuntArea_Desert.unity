MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 328460339}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa kertas terlipat
  radius: 3.2
  speakerName: 
  speakerRole: 
  title: Surat yang Tak Terkirim
  message: 'Di kaki dinding yang berlapis merah dan jingga, berlubang oleh angin
    selama ribuan tahun, terselip kertas terlipat kecil di bawah sebuah batu pipih.
    Tintanya memudar, tetapi masih terbaca:


    "Aku merindukanmu seperti orang
    merindukan roti panas di hari hujan."


    Biasa saja. Tidak puitis. Hanya sangat
    banyak. Kertas ini tak pernah dikirim ke mana pun.'
