MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 583029206}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa bekas kemah
  radius: 5
  speakerName: 
  speakerRole: 
  title: Dasar Sungai Kering
  message: 'Dulu air mengalir di sini; kini hanya tersisa dinding tanah merah dan
    batu-batu bulat yang dulu digulirkannya. Para kafilah berkemah di dasarnya karena
    terlindung dari angin, memungut semak kering dan kayu hanyut yang terdampar di
    tepi. Abu di cincin batu itu sudah dingin.


    Siang di gurun menindih tengkuk.
    Begitu matahari turun, panasnya lenyap sekaligus, seperti selimut yang ditarik,
    dan pasir berubah menjadi hamparan dingin yang berkerak di bawah bintang. Malam
    di gurun sedingin hukuman yang dijatuhkan untuk siangnya. Bawalah garam dan kayu
    bakar.'
