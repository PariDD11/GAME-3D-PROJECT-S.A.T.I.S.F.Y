  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa Lengkung Putih
  radius: 4.5
  speakerName: 
  speakerRole: 
  title: Gerbang Terakhir
  message: 'Sebuah lengkung putih berdiri sendirian di ujung selatan aula, tanpa
    tembok di kiri maupun kanannya. Dari aula, orang melihat tangga cahaya melingkar
    naik di balik lengkung itu, makin tinggi, sampai hilang di antara bintang.


    Para
    pendaki yang pernah sampai di sini menyebutnya Gerbang Terakhir. Tak seorang
    pun mau menaruh telapak tangan di batunya, sebab batu itu tidak dingin; ia hangat,
    seperti sesuatu yang baru saja ditinggalkan.'
