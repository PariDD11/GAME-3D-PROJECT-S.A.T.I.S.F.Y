  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa Retakan
  radius: 4.5
  speakerName: 
  speakerRole: 
  title: Retakan di Ujung Aula
  message: 'Di ujung utara aula, sebuah garis hitam setipis rambut membelah pualam
    dari kiri ke kanan lalu berhenti begitu saja. Tak ada bekas pukulan, tak ada
    serpihan, dan debu pun tak singgah di dalamnya. Pendaki yang mencoba menyelipkan
    ujung pisau ke celah itu mengaku pisaunya tak masuk, padahal celahnya jelas terlihat.


    Batu
    di kedua sisinya hangat, seperti lantai tempat seseorang baru saja bangun.'
