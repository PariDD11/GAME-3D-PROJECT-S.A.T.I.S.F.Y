  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa Pecahan Bilah
  radius: 4.2
  speakerName: 
  speakerRole: 
  title: Pecahan di Tengah Aula
  message: 'Sepotong bilah putih tertancap miring di tengah lantai, setinggi dua
    orang berdiri. Ujungnya patah rata, gagangnya tak ada, dan pualam di sekelilingnya
    tak punya satu pun retak. Satu garis tipis di sepanjang bilah itu berpendar sepucat
    bintang-bintang di atas.


    Pendaki yang pernah sampai di sini jarang mau
    menceritakannya. Yang mau hanya berkata bahwa bilah itu tak pernah terasa seperti
    benda mati.'
