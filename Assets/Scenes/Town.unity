  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Baca Papan Pengumuman
  radius: 3.4
  speakerName: 
  speakerRole: 
  title: Papan Pengumuman Guild
  message: "PENGUMUMAN GUILD PETUALANG ASHWATCH\n\n\u2022 Permintaan berburu, pengantaran,
    dan penyelidikan diperbarui tiap pagi di Papan Misi di dalam Guild.\n\u2022 Ujian
    kenaikan pangkat diadakan di Arena Ujian; daftar lebih dulu pada resepsionis.\n\u2022
    Dilarang menghunus senjata di dalam tembok kota.\n\u2022 Gerbang Kastil hanya
    dibuka untuk Hunter level 20 ke atas.\n\n\u2014 Kepala Guild Ashwatch"
