  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa Menara Lonceng
  radius: 3.4
  speakerName: 
  speakerRole: 
  title: Lonceng Katedral
  message: 'Lonceng Katedral berdentang tiap fajar dan senja. Enam kali, sama panjang,
    lalu kota diam: pedagang menahan timbangan, penjaga berhenti melangkah, ibu-ibu
    menunggu sampai tujuh tarikan napas sebelum bicara lagi.


    Anak-anak diajari
    kebiasaan itu sebelum diajari berhitung. Yang baru datang ke kota biasanya tertawa
    pada hari pertama, dan berhenti tertawa pada hari ketiga.'
