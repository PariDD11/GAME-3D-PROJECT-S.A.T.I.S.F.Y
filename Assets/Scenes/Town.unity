  m_GameObject: {fileID: 1858974824}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa Retakan
  radius: 3.4
  speakerName: 
  speakerRole: 
  title: Retak di Muka Katedral
  message: 'Garis-garis hitam setipis rambut merayap di batu putih muka Katedral,
    dari kaki tembok sampai setinggi tiga lantai. Tukang batu sudah menambalnya tiga
    kali sejak musim dingin; tiap pagi retak itu ada lagi, sehitam dan setipis semula.


    Warga
    menyarankan agar tak menaruh telapak tangan di dinding itu menjelang subuh. Tak
    seorang pun mau bilang apa sebabnya.'
--- !u!1 &1859129560
