  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Tempa Hadrik
  radius: 3.8
  speakerName: 
  speakerRole: 
  title: Tempa Hadrik
  message: 'Bengkel tua di sudut utara Tembok Dalam. Dindingnya hitam jelaga, tungkunya
    tak pernah benar-benar padam.


    Dari dalam terdengar palu: tiga kali, diam
    sejenak, tiga kali lagi. Hadrik Batu tidak melayani pembeli di sini; untuk senjata
    dan zirah, pergilah ke Pandai Besi di Plaza Gerbang.'
