MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1859129560}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa Sumur Tua
  radius: 3.2
  speakerName: 
  speakerRole: 
  title: Sumur Bertutup Papan
  message: 'Lima papan menutup mulut sumur ini, ditindih batu dan diikat tali merah.
    Garam ditaburkan melingkar di sekelilingnya, dua jari lebar, tanpa putus.


    Orang-orang
    ladang menimba di sumur lain. Para penggali sumur Ashwatch selalu berhenti pada
    kedalaman yang sama, dan tak seorang pun mau berkata mengapa.'
