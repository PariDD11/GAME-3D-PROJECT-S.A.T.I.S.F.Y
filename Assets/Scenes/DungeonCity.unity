MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1915726292}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa tali lentera
  radius: 4.5
  speakerName: 
  speakerRole: 
  title: Tali Lentera Festival
  message: 'Tali-tali lentera ini dibentangkan di antara delapan obelisk setiap menjelang
    Festival Cahaya Salju, dan tak seorang pun pernah menurunkannya sesudah festival
    usai. Enam warna bergantian: emas, biru muda, hijau muda, merah muda, ungu, jingga.
    Lalu satu kait kosong. Lalu enam warna lagi.


    Tukang gantung lentera berkata
    kait kosong itu bukan kelalaian. "Pesanannya begitu sejak tali yang pertama,"
    katanya. "Satu kait selalu dibiarkan menunggu." Ia tidak tahu apa yang ditunggu,
    dan ia tidak suka ditanya.'
