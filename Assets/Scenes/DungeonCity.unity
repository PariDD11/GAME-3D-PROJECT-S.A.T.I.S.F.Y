MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1341177543}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa jalan ini
  radius: 6.5
  speakerName: 
  speakerRole: 
  title: Jalan Pengrajin Lilin
  message: 'Bau madu dan lemak hangat memenuhi busur jalan ini sebelum fajar. Para
    pengrajin merendam sumbu berkali-kali, dan menjelang musim dingin mereka tak
    sempat tidur: seluruh kota memesan lilin dan lentera untuk Festival Cahaya Salju.


    Pengrajin
    di sini tidak pernah menjual satu batang saja. Sudah menjadi kebiasaan menjual
    enam, dan tak seorang pun ingat sebabnya. Di tengah busur ada toko roti, dan
    di jalan di depannya batu pavingnya dilingkari tali merah.'
