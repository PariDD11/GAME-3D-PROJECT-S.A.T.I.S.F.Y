  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 630000176}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa lengkung menara
  radius: 3.6
  speakerName: 
  speakerRole: 
  title: Lengkung Menara
  message: 'Gerbang besar berbingkai emas di muka menara ini bukan pintu. Tidak ada
    engsel, tidak ada ambang, tidak ada kunci. Orang masuk karena menara membiarkannya.


    Bila
    tujuh orang berdiri di depannya, cahaya di lengkungnya menghitam lalu kosong.
    Tidak terbuka. Hilang, seperti kulit yang menarik diri dari luka.


    Tujuh
    pijakan putih di lantai ini licin oleh kaki orang yang menunggu giliran. Tak
    seorang pun tahu siapa yang memasangnya.'
