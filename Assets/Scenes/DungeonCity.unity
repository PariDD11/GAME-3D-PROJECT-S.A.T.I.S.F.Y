MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1557833803}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa toko roti
  radius: 2.8
  speakerName: 
  speakerRole: 
  title: Toko Roti dan Anjing Kuning
  message: 'Anjing kuning yang kurus ini duduk di anak tangga toko roti. Pemilik
    toko berkata ia datang tanpa ada yang memanggil, tidak pernah mengemis, dan menolak
    roti yang disodorkan padanya. Ia tidak menatap pintu, tidak menatap orang yang
    lewat. Ia menatap batu jalan yang retak di depan toko, yang kini dilingkari tali
    merah dan enam lilin.


    "Dia sudah begitu sejak batu itu retak," kata pemilik
    toko. "Telinganya bergerak setiap kali tanah di bawah kakimu berdenyut. Aku sendiri
    tidak pernah merasakannya."'
