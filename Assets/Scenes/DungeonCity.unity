MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1050073212}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa Kantor Pendaki
  radius: 3.8
  speakerName: 
  speakerRole: 
  title: Kantor Pendaki
  message: 'Aula berdinding batu ini lebih tua daripada kota di sekelilingnya. Setiap
    pendaki yang hendak naik menuliskan namanya di buku besar di dalam, lalu menggores
    catatannya sendiri di tembok luar sebelum berangkat. Tidak ada aturan yang menyuruhnya.
    Tidak seorang pun pernah mengajarinya.


    Petugas kantor berkata bukunya hanya
    mencatat yang naik. "Tembok itulah yang menghitung," katanya. Ia menolak ditanya
    siapa yang membuat goresan pertama, dan ia tidak pernah berdiri di dalam lorong
    gerbang setelah hari gelap.'
