--- !u!114 &365703009
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 365703007}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa gerbang pos
  radius: 6
  speakerName: 
  speakerRole: 
  title: Pos Barat
  message: 'Pos Barat berdiri di ujung jalan niaga terakhir sebelum dataran. Di luar
    gerbang kayu ini tak ada lagi kios, tak ada lagi harga, tak ada lagi orang yang
    bisa ditagih. Di tepi jalan di bawah papan ini berderet kios lampu, tali, garam,
    dan bekal, dan semuanya menutup dagangan sebelum gelap.


    Pedagang tua di
    kios paling dekat gerbang berkata ia sudah berhenti menghitung orang yang berangkat
    dari sini dan tak kembali. "Yang kembali membeli lampu lagi," katanya. "Yang
    tidak kembali tidak perlu lampu."'
