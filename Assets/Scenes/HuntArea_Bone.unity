MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1801650450}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa nisan
  radius: 5.5
  speakerName: 
  speakerRole: 
  title: Nisan Tanpa Nama
  message: 'Batu-batu rendah berderet ke barat, jauh melewati tempat mata masih bisa
    menghitungnya. Tak satu pun memuat nama. Di muka tiap batu hanya ada goresan,
    tiga di kiri dan tiga di kanan, dalam dan lurus seperti digores dengan satu gerakan.


    Kata
    orang pos, goresan itu bukan buatan pemburu mana pun. Semuanya menghadap batu
    yang bernama, seperti menunggu giliran dipanggil.'
