--- !u!114 &1175827799
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1175827797}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa gantungan papan
  radius: 4.2
  speakerName: 
  speakerRole: 
  title: Gantungan Papan
  message: 'Puluhan papan kayu sekecil telapak tangan tergantung pada tali di gantungan
    ini, dan semuanya polos. Tak ada tinta di satu pun. Di batu sebelah hanya ada
    dua nama, ditulis dengan tinta emas; selebihnya di padang ini tidak bernama.


    Penjaga
    pos berkata papan-papan itu sudah tergantung sebelum ia bertugas, dan jumlahnya
    tak pernah bertambah atau berkurang. Pemburu yang akan turun ke tangga biasanya
    menyentuh satu, tetapi tak seorang pun menuliskan apa-apa.'
