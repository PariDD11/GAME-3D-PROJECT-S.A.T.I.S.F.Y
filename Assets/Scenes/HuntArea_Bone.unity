MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1786722872}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa anjing batu
  radius: 11
  speakerName: 
  speakerRole: 
  title: Anjing Batu Gerbang
  message: 'Dua anjing batu duduk di kiri dan kanan jalan, masing-masing dengan tiga
    kepala yang menghadap tiga arah sekaligus. Matanya cekung dan terisi cahaya biru
    pucat yang tak berkedip. Tubuh batunya lebih lebar daripada pintu mana pun di
    dataran ini.


    Penjaga pos tak tahu siapa yang memahatnya, atau apakah patung-patung
    ini ada lebih dahulu daripada penjaga hidup yang berkeliaran di depan gerbang.
    Katanya, yang satu selalu tampak seperti ingatan tentang yang lain.'
