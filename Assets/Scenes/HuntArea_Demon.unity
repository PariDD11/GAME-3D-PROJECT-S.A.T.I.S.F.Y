--- !u!114 &2018226903
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2018226901}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa takhta
  radius: 8
  speakerName: 
  speakerRole: 
  title: Takhta Iblis
  message: 'Takhta ini terlalu tinggi untuk satu orang dan terlalu sepi untuk yang
    lain. Sandarannya hitam dan retak, dan dari retakan itu naik cahaya jingga yang
    tak berkedip. Di dudukannya ada cekungan bundar dangkal seukuran cap segel, tepat
    di tempat pangkuan akan berada. Tak ada debu di dalamnya.


    Pemburu yang
    pulang dari sini tak mau bercerita siapa yang biasa duduk di sana. Mereka hanya
    bilang kursi itu selalu terasa hangat.'
