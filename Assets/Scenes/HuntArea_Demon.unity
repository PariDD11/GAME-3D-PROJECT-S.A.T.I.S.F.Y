  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa anak tangga
  radius: 7
  speakerName: 
  speakerRole: 
  title: Seratus Anak Tangga
  message: 'Anak tangga obsidian ini dihitung seratus oleh setiap orang yang menaikinya,
    tetapi tak dua orang pun mendapat hitungan yang sama di tengah jalan. Tak satu
    pun bergetar di bawah kaki, bahkan ketika tanah di dataran sekitarnya berguncang,
    dan lampu ungu di sisinya tak pernah berkedip.


    Penjaga gerbang lembah berkata
    tangga ini sudah begitu sebelum lembah ini diberi nama.'
