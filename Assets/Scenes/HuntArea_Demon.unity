  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa tanah
  radius: 12
  speakerName: 
  speakerRole: 
  title: Dataran Retakan
  message: 'Tanah dataran ini pecah berpetak-petak seperti sisik yang mengering,
    merah di tepinya dan hitam di dalam celah. Dari beberapa celah naik uap kuning
    yang berbau belerang, dari yang lain hanya naik hangat, dan dari satu dua celah
    yang paling lebar terlihat cahaya jingga jauh di bawah. Tak ada angin; uapnya
    naik lurus seperti tiang.


    Para pemburu hafal petak mana yang aman diinjak,
    tetapi tak seorang pun ingat siapa yang pertama kali menunjukkannya.'
