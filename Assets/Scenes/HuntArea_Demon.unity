MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1090454135}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa tungku
  radius: 4.2
  speakerName: 
  speakerRole: 
  title: Tungku Roti
  message: 'Tungku batu pendek dengan mulut yang masih hangat. Di rak depannya berderet
    delapan roti yang hangus sampai hitam, sama bentuknya satu dengan yang lain.
    Bau gosongnya sampai ke tepi jurang, bercampur bau bawang yang bergantung di
    muka pondok.


    Tak seorang pun tahu siapa yang memanggangnya atau untuk siapa.
    Kata pemburu yang pernah bertanya, satu roti selalu hilang dari rak sebelum ia
    selesai bertanya.'
