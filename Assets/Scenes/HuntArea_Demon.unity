MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1222882671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 33f8bc2026be31b46b6bb4f354b4ea80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HunterGuild.InfoPoint
  prompt: Periksa batu hitam
  radius: 6.5
  speakerName: 
  speakerRole: 
  title: Jantung Obsidian
  message: 'Dua tiang obsidian hitam bersandar satu sama lain di belakang pondok,
    dan di celah sempit di antaranya ada cahaya jingga yang berdenyut pelan, seperti
    bara yang tak pernah padam dan tak pernah membesar. Batu di sekitarnya licin
    dan hangat, seolah baru saja disentuh orang.


    Para pemburu yang lewat berkata
    mereka tak pernah melihat Varra mencari kayu bakar, dan tak pernah melihat tumpukan
    kayunya berkurang.'
